<!DOCTYPE html>
<html lang="zh-TW">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>💣 上新莊炸彈傳傳樂</title>

<style>
*{box-sizing:border-box}
body{
 margin:0;
 font-family:Arial,"Microsoft JhengHei",sans-serif;
 background:#0b1425;
 color:#fff;
}
header{
 text-align:center;
 padding:25px 12px;
 background:#172b49;
}
h1{margin:0;font-size:28px}
header p{color:#b9c8df}
.wrap{max-width:850px;margin:auto;padding:15px}
.card{
 background:#17263d;
 border:1px solid #324764;
 border-radius:16px;
 padding:20px;
 margin-bottom:15px;
}
h2{font-size:21px;margin:0 0 15px}
label{display:block;margin:12px 0 5px}
input,select{
 width:100%;
 padding:13px;
 font-size:16px;
 border:1px solid #4a6384;
 border-radius:10px;
 background:#0e1b2e;
 color:white;
}
button{
 padding:13px;
 min-height:48px;
 border:0;
 border-radius:10px;
 background:#3875c9;
 color:white;
 font-size:16px;
 font-weight:bold;
 cursor:pointer;
}
button:disabled{opacity:.4}
.full{width:100%}
.gold{background:#f1ad36;color:#19243a}
.red{background:#c74750}
.gray{background:#30465f}
.hide{display:none!important}
.row{
 display:flex;
 justify-content:space-between;
 align-items:center;
 gap:10px;
 flex-wrap:wrap;
}
.grid{
 display:grid;
 grid-template-columns:repeat(auto-fit,minmax(145px,1fr));
 gap:10px;
}
.badge{
 background:#30445e;
 padding:8px 12px;
 border-radius:25px;
 font-size:14px;
}
.notice{
 background:#253e5d;
 padding:13px;
 border-radius:10px;
 line-height:1.7;
}
.muted{color:#bacbe1;font-size:14px;line-height:1.7}
.center{text-align:center}
.bomb{
 font-size:75px;
 text-align:center;
 margin:12px;
 animation:bob 1s infinite alternate;
}
@keyframes bob{
 to{transform:translateY(-8px)}
}
.danger{
 background:#5b1d30;
 border:2px solid #ff6a73;
}
.names{
 display:grid;
 grid-template-columns:repeat(2,1fr);
 gap:10px;
 margin-top:15px;
}
.names button{background:#294c71}
.player{
 padding:12px 0;
 border-bottom:1px solid #31435d;
 display:flex;
 justify-content:space-between;
 gap:10px;
}
.out{opacity:.5}
.winner{
 color:#ffd78b;
 font-size:23px;
 font-weight:bold;
 padding:10px;
}
#toast{
 position:fixed;
 bottom:20px;
 left:50%;
 transform:translateX(-50%);
 background:#f1ad36;
 color:#19243a;
 padding:12px 20px;
 border-radius:12px;
 display:none;
 z-index:99;
}
@media(prefers-reduced-motion:reduce){
 .bomb{animation:none}
}
</style>
</head>

<body>

<header>
<h1>💣 上新莊炸彈傳傳樂</h1>
<p>多人即時連線・經典模式・快速淘汰</p>
</header>

<main class="wrap">

<section id="entry" class="card">

<h2>🎮 加入遊戲</h2>

<div id="conn" class="notice">
正在連線 Firebase...
</div>

<label>房間代碼</label>
<input id="code" maxlength="20" placeholder="例如 BOMB888">

<label>你的暱稱</label>
<input id="nickname" maxlength="16" placeholder="輸入名字">

<br><br>

<button id="join" class="gold full" disabled>
連線中...
</button>

<p class="muted">
第一位建立房間的人自動成為主持人。<br>
主持人不參賽，至少3位玩家即可開始。
</p>

</section>


<div id="game" class="hide">

<section class="card">

<div class="row">
<h2 id="roomTitle">遊戲房間</h2>
<span id="role" class="badge"></span>
</div>

<div id="state" class="notice">
等待遊戲開始
</div>

<br>

<div class="row">
<span id="count" class="badge">存活0人</span>
<span id="round" class="badge">第0回合</span>
<span id="mode" class="badge">經典模式</span>
</div>

<br>

<div class="grid">
<button id="share" class="gray">📤 分享房間</button>
<button id="leave" class="gray">🚪 離開畫面</button>
</div>

</section>


<section id="hostPanel" class="card hide">

<h2>👑 主持人控制台</h2>

<div id="setup">

<label>遊戲模式</label>

<select id="modeSelect">
<option value="classic">💣 經典模式（1顆炸彈）</option>
<option value="fast">💣💣 快速模式（多顆炸彈）</option>
</select>

<label>得獎方式</label>

<select id="finishSelect">
<option value="three">剩下3人結束</option>
<option value="one">繼續至最後1人（排名）</option>
</select>

<p class="muted">
只有3位玩家時，自動進行到最後1人，方便測試。
每顆炸彈隨機15～30秒爆炸。
</p>

<button id="start" class="gold full">
▶️ 開始遊戲
</button>

</div>

<div id="hostActions" class="hide">

<p id="hostInfo" class="muted"></p>

<button id="next" class="gold full hide">
💣 開始下一回合
</button>

<button id="settle" class="red full hide">
💥 處理到期炸彈
</button>

</div>

<br>

<button id="reset" class="gray full">
🔄 重新開始遊戲
</button>

</section>


<section class="card">

<h2>💣 即時炸彈戰況</h2>

<div id="bombs" class="grid">
等待主持人開始...
</div>

<p class="muted">
拿到炸彈的人可以指定其他玩家傳遞。<br>
不能立即傳回上一位玩家。<br>
同一位玩家不能同時持有兩顆炸彈。
</p>

</section>


<section id="winnerPanel" class="card hide">

<h2>🏆 得獎名單</h2>

<div id="winners"></div>

</section>


<section class="card">

<div class="row">
<h2>👥 玩家名單</h2>
<span id="total" class="badge">0人</span>
</div>

<div id="playerList">
等待玩家加入...
</div>

</section>


<section class="card">

<h2>📜 淘汰紀錄</h2>

<div id="logs" class="muted">
尚無紀錄
</div>

</section>

</div>
</main>

<div id="toast"></div>


<script type="module">

import {
 initializeApp
} from "https://www.gstatic.com/firebasejs/10.14.1/firebase-app.js";

import {
 getAuth,
 signInAnonymously,
 onAuthStateChanged
} from "https://www.gstatic.com/firebasejs/10.14.1/firebase-auth.js";

import {
 getFirestore,
 doc,
 collection,
 getDoc,
 setDoc,
 onSnapshot,
 runTransaction,
 serverTimestamp
} from "https://www.gstatic.com/firebasejs/10.14.1/firebase-firestore.js";


/* =====================================
   新 Firebase 專案
===================================== */

const firebaseConfig = {
 apiKey:"AIzaSyByWLmFGZYZpwF60daHSxzTN22bUWXnHbQ",
 authDomain:"shangxin-bomb-game.firebaseapp.com",
 projectId:"shangxin-bomb-game",
 storageBucket:"shangxin-bomb-game.firebasestorage.app",
 messagingSenderId:"944292892956",
 appId:"1:944292892956:web:8fa456f6706d0c69686ad9"
};

const app=initializeApp(firebaseConfig);
const db=getFirestore(app);
const auth=getAuth(app);

const $=id=>document.getElementById(id);

let uid="";
let room="";
let host=false;

let roomData=null;
let players=[];
let bombs=[];

let unsubs=[];
let bombUnsubs=[];

let busy=false;
let settling=false;
let hostTimer=null;

let joining=false;


/* =====================================
   工具函式
===================================== */

function show(id,yes){
 $(id).classList.toggle("hide",!yes);
}

function msg(text){
 const el=$("toast");
 el.textContent=text;
 el.style.display="block";

 clearTimeout(msg.timer);

 msg.timer=setTimeout(()=>{
  el.style.display="none";
 },3000);
}

function error(e){
 console.error(e);
 alert("操作失敗："+(e.message||e));
}

function pname(id){
 return players.find(p=>p.id===id)?.name||"玩家";
}

function rref(){
 return doc(db,"bombRooms",room);
}

function pref(id){
 return doc(db,"bombRooms",room,"players",id);
}

function bref(id){
 return doc(db,"bombRooms",room,"bombs",id);
}

function alive(){
 return roomData?.alive||[];
}

function activeBombs(){
 return bombs.filter(b=>
  b.status==="active" &&
  b.round===roomData?.round
 );
}

function cleanup(){

 unsubs.forEach(fn=>fn());
 bombUnsubs.forEach(fn=>fn());

 unsubs=[];
 bombUnsubs=[];

 clearTimeout(hostTimer);
 hostTimer=null;

}


/* =====================================
   快速模式炸彈數量
===================================== */

function bombCount(n,mode){

 if(mode==="classic")return 1;

 if(n>=40)return 5;
 if(n>=30)return 4;
 if(n>=20)return 3;
 if(n>=10)return 2;

 return 1;
}

function shuffle(arr){

 const a=[...arr];

 for(let i=a.length-1;i>0;i--){

  const j=Math.floor(Math.random()*(i+1));

  [a[i],a[j]]=[a[j],a[i]];

 }

 return a;
}


/* =====================================
   Firebase 登入
===================================== */

onAuthStateChanged(auth,user=>{

 if(user){

  uid=user.uid;

  $("conn").textContent="✅ Firebase 已連線";

  $("join").disabled=false;
  $("join").textContent="加入／建立房間";

 }

});

signInAnonymously(auth).catch(error);


/* =====================================
   預填資料
===================================== */

$("code").value=
 new URLSearchParams(location.search).get("room")||"";

$("nickname").value=
 localStorage.getItem("bombNickname")||"";


/* =====================================
   建立／加入房間
===================================== */

$("join").onclick=async()=>{

 if(!uid||joining)return;

 const code=$("code").value
  .trim()
  .toUpperCase()
  .replace(/[^A-Z0-9_-]/g,"")
  .slice(0,20);

 const nick=$("nickname").value.trim().slice(0,16);

 if(!code||!nick){
  alert("請輸入房間代碼與暱稱");
  return;
 }

 joining=true;
 $("join").disabled=true;

 try{

  const ref=doc(db,"bombRooms",code);

  await runTransaction(db,async tx=>{

   const snap=await tx.get(ref);

   if(!snap.exists()){

    tx.set(ref,{
     hostUid:uid,
     phase:"lobby",
     round:0,
     mode:"classic",
     target:3,
     alive:[],
     eliminated:[],
     winners:[],
     history:[],
     bombTotal:0,
     createdAt:serverTimestamp()
    });

   }

  });

  const snap=await getDoc(ref);
  const d=snap.data();

  const isHost=d.hostUid===uid;

  if(!isHost){

   const playerRef=doc(
    db,"bombRooms",code,"players",uid
   );

   const playerSnap=await getDoc(playerRef);

   if(!playerSnap.exists()){

    if(d.phase!=="lobby"){
     throw Error("遊戲已開始，不能加入");
    }

    await setDoc(playerRef,{
     name:nick,
     joinedAt:serverTimestamp()
    });

   }

  }

  cleanup();

  room=code;
  host=isHost;
  roomData=null;
  players=[];
  bombs=[];

  localStorage.setItem("bombNickname",nick);

  show("entry",false);
  show("game",true);

  history.replaceState(
   {},
   "",
   location.pathname+"?room="+encodeURIComponent(room)
  );

  listen();

 }catch(e){
  error(e);
 }finally{
  joining=false;
  $("join").disabled=false;
 }

};


/* =====================================
   即時監聽
===================================== */

function listen(){

 unsubs.push(

  onSnapshot(rref(),snap=>{

   if(!snap.exists())return;

   const previous=roomData?.round;

   roomData=snap.data();

   if(previous!==roomData.round){
    listenBombs();
   }

   render();
   scheduleHost();

  },error)

 );

 unsubs.push(

  onSnapshot(
   collection(db,"bombRooms",room,"players"),
   snap=>{

    players=snap.docs.map(d=>({
     id:d.id,
     ...d.data()
    }));

    render();

   },
   error
  )

 );

}


/* =====================================
   炸彈即時監聽
===================================== */

function listenBombs(){

 bombUnsubs.forEach(fn=>fn());

 bombUnsubs=[];
 bombs=[];

 if(!roomData||roomData.round===0)return;

 const count=roomData.bombTotal||1;

 for(let i=1;i<=Math.min(5,count);i++){

  const id=`${roomData.round}_${i}`;

  bombUnsubs.push(

   onSnapshot(bref(id),snap=>{

    bombs=bombs.filter(b=>b.id!==id);

    if(snap.exists()){

     bombs.push({
      id,
      ...snap.data()
     });

    }

    render();
    scheduleHost();

   },error)

  );

 }

}


/* =====================================
   畫面更新
===================================== */

function render(){

 if(!roomData)return;

 const d=roomData;
 const living=alive();

 $("roomTitle").textContent="房間："+room;

 $("role").textContent=
  host?"👑 主持人":"🎮 "+pname(uid);

 const status={
  lobby:"⏳ 等待主持人開始",
  playing:"💣 炸彈傳遞中！隨時可能爆炸",
  between:"💥 本回合結束，等待下一回合",
  finished:"🏆 比賽結束！"
 };

 $("state").textContent=status[d.phase]||d.phase;

 $("count").textContent="存活 "+living.length+" 人";

 $("round").textContent="第 "+d.round+" 回合";

 $("mode").textContent=
  d.mode==="fast"?"快速模式":"經典模式";

 $("total").textContent=players.length+"位玩家";

 show("hostPanel",host);

 show("setup",host&&d.phase==="lobby");

 show("hostActions",host&&d.phase!=="lobby");

 $("start").disabled=busy||players.length<3;

 $("hostInfo").textContent=
  "存活："+living.length+
  "人｜本回合炸彈："+d.bombTotal+
  "顆｜目標剩餘："+d.target+"人";

 show("next",host&&d.phase==="between");

 $("next").disabled=busy;

 show(
  "settle",
  host&&
  d.phase==="playing"&&
  activeBombs().some(b=>Date.now()>=b.deadline)
 );

 $("settle").disabled=busy;


 /* 玩家名單 */

 const list=$("playerList");
 list.replaceChildren();

 for(const p of players){

  const row=document.createElement("div");
  row.className="player";

  const left=document.createElement("strong");
  left.textContent=
   p.name+(p.id===uid?"（我）":"");

  const right=document.createElement("span");

  if(d.phase==="lobby"){
   right.textContent="🟢 已加入";
  }else if(living.includes(p.id)){
   right.textContent="💚 存活";
  }else{
   right.textContent="💥 淘汰";
   row.classList.add("out");
  }

  row.append(left,right);
  list.append(row);

 }


 /* 炸彈畫面 */

 const box=$("bombs");
 box.replaceChildren();

 if(d.phase==="lobby"){

  box.textContent="等待主持人開始遊戲";

 }else if(d.phase==="finished"){

  box.textContent="🎊 遊戲已結束！";

 }else{

  const current=bombs.filter(
   b=>b.round===d.round
  );

  if(!current.length){
   box.textContent="正在配置炸彈...";
  }

  for(const b of current){

   const card=document.createElement("div");

   card.className="card";

   card.style.margin="0";

   if(
    b.status==="active"&&
    b.holder===uid
   ){
    card.classList.add("danger");
   }

   const title=document.createElement("h2");
   title.textContent="💣 炸彈 "+b.id;

   const icon=document.createElement("div");
   icon.className="bomb";
   icon.textContent=
    b.status==="exploded"?"💥":"💣";

   const holder=document.createElement("p");
   holder.className="center";

   holder.textContent=
    b.status==="exploded"
    ?"💥 淘汰："+pname(b.holder)
    :"目前持有人："+pname(b.holder);

   card.append(title,icon,holder);


   /* 只有持有人可以傳遞 */

   if(
    b.status==="active"&&
    b.holder===uid&&
    !host
   ){

    const tip=document.createElement("p");

    tip.className="center";
    tip.textContent="🚨 炸彈在你手上！快傳出去！";

    card.append(tip);

    const choices=document.createElement("div");
    choices.className="names";

    const occupied=new Set(
     activeBombs().map(x=>x.holder)
    );

    const options=living.filter(id=>
     id!==uid&&
     id!==b.previous&&
     !occupied.has(id)
    );

    if(!options.length){

     const p=document.createElement("p");
     p.className="muted";
     p.textContent="目前沒有可傳遞的玩家";

     choices.append(p);

    }

    for(const id of options){

     const button=document.createElement("button");

     button.textContent="➡️ "+pname(id);
     button.disabled=busy;

     button.onclick=()=>passBomb(b,id);

     choices.append(button);

    }

    card.append(choices);

   }

   box.append(card);

  }

 }


 /* 得獎名單 */

 show("winnerPanel",d.phase==="finished");

 const winners=$("winners");
 winners.replaceChildren();

 (d.winners||[]).forEach((id,index)=>{

  const div=document.createElement("div");
  div.className="winner";

  div.textContent=
   (["🥇","🥈","🥉"][index]||"🏆")+
   " "+pname(id);

  winners.append(div);

 });


 /* 淘汰紀錄 */

 const logs=$("logs");
 logs.replaceChildren();

 if(!d.history?.length){

  logs.textContent="尚無紀錄";

 }else{

  [...d.history].reverse().forEach(h=>{

   const div=document.createElement("div");
   div.className="player";

   div.textContent=
    "第"+h.round+"回合｜💥 "+
    pname(h.player)+" 淘汰";

   logs.append(div);

  });

 }

}


/* =====================================
   開始回合
===================================== */

async function beginRound(d,first=false){

 const ids=first
  ?players.map(p=>p.id)
  :d.alive;

 if(ids.length<=d.target&&!first){
  throw Error("已達到得獎人數");
 }

 const count=Math.min(
  bombCount(ids.length,d.mode),
  Math.max(1,ids.length-d.target)
 );

 const chosen=shuffle(ids).slice(0,count);

 const nextRound=d.round+1;

 await runTransaction(db,async tx=>{

  const snap=await tx.get(rref());
  const now=snap.data();

  if(
   !now||
   now.hostUid!==uid||
   now.phase!==(first?"lobby":"between")||
   now.round!==d.round
  ){
   throw Error("房間狀態已變更");
  }

  const base=Date.now();

  tx.update(rref(),{
   phase:"playing",
   round:nextRound,
   alive:ids,
   mode:d.mode,
   target:d.target,
   bombTotal:count
  });

  for(let i=0;i<count;i++){

   const duration=
    15000+Math.floor(Math.random()*15001);

   tx.set(bref(`${nextRound}_${i+1}`),{
    holder:chosen[i],
    previous:"",
    round:nextRound,
    status:"active",
    deadline:base+duration,
    lastPassedAt:base,
    passes:0
   });

  }

 });

}


/* =====================================
   主持人開始遊戲
===================================== */

$("start").onclick=async()=>{

 if(!host||busy)return;

 if(players.length<3){
  alert("至少需要3位玩家");
  return;
 }

 busy=true;

 try{

  const mode=$("modeSelect").value;

  const target=
   players.length===3
   ?1
   :$("finishSelect").value==="one"
    ?1
    :3;

  await beginRound({
   ...roomData,
   mode,
   target
  },true);

  msg("💣 遊戲開始！");

 }catch(e){
  error(e);
 }finally{
  busy=false;
  render();
 }

};


/* =====================================
   開始下一回合
===================================== */

$("next").onclick=async()=>{

 if(!host||busy)return;

 busy=true;

 try{

  await beginRound(roomData);

  msg("🔥 下一回合開始！");

 }catch(e){
  error(e);
 }finally{
  busy=false;
  render();
 }

};


/* =====================================
   玩家傳遞炸彈
===================================== */

async function passBomb(b,target){

 if(busy||roomData?.phase!=="playing")return;

 busy=true;
 render();

 try{

  await runTransaction(db,async tx=>{

   const roomSnap=await tx.get(rref());
   const bombSnap=await tx.get(bref(b.id));

   const r=roomSnap.data();
   const v=bombSnap.data();

   if(
    !r||
    r.phase!=="playing"||
    r.round!==b.round||
    !v||
    v.status!=="active"||
    v.holder!==uid
   ){
    throw Error("炸彈已被傳走或回合結束");
   }

   if(Date.now()>=v.deadline){
    throw Error("炸彈已到爆炸時間");
   }

   if(Date.now()-v.lastPassedAt<1000){
    throw Error("傳遞間隔至少1秒");
   }

   if(
    target===uid||
    target===v.previous||
    !r.alive.includes(target)
   ){
    throw Error("不能傳給這位玩家");
   }

   const otherIds=Array.from(
    {length:Math.min(5,r.bombTotal||1)},
    (_,i)=>`${r.round}_${i+1}`
   ).filter(id=>id!==b.id);

   const others=[];

   for(const id of otherIds){
    others.push(await tx.get(bref(id)));
   }

   if(others.some(s=>
    s.exists()&&
    s.data().status==="active"&&
    s.data().holder===target
   )){
    throw Error("對方已持有其他炸彈");
   }

   tx.update(bref(b.id),{
    holder:target,
    previous:uid,
    lastPassedAt:Date.now(),
    passes:v.passes+1
   });

  });

  msg("💨 炸彈傳遞成功！");

 }catch(e){
  error(e);
 }finally{
  busy=false;
  render();
 }

}


/* =====================================
   主持人自動爆炸計時
===================================== */

function scheduleHost(){

 clearTimeout(hostTimer);
 hostTimer=null;

 if(
  !host||
  !roomData||
  roomData.phase!=="playing"||
  settling
 )return;

 const current=activeBombs();

 if(!current.length)return;

 const nearest=Math.min(
  ...current.map(b=>b.deadline)
 );

 hostTimer=setTimeout(
  settleExpired,
  Math.max(150,nearest-Date.now()+150)
 );

}


/* =====================================
   爆炸結算
===================================== */

async function settleExpired(){

 if(
  !host||
  settling||
  roomData?.phase!=="playing"
 )return;

 settling=true;

 clearTimeout(hostTimer);

 try{

  const due=activeBombs()
   .filter(b=>Date.now()>=b.deadline)
   .sort((a,b)=>a.deadline-b.deadline);

  for(const b of due){

   await runTransaction(db,async tx=>{

    const roomSnap=await tx.get(rref());
    const bombSnap=await tx.get(bref(b.id));

    const r=roomSnap.data();
    const v=bombSnap.data();

    if(
     !r||
     r.phase!=="playing"||
     r.round!==b.round||
     !v||
     v.status!=="active"||
     Date.now()<v.deadline
    )return;

    const living=[...r.alive];

    if(!living.includes(v.holder))return;

    const remaining=living.filter(
     id=>id!==v.holder
    );

    const history=[
     ...(r.history||[]),
     {
      round:r.round,
      player:v.holder,
      bomb:b.id
     }
    ];

    const eliminated=[
     ...(r.eliminated||[]),
     v.holder
    ];

    const finish=remaining.length<=r.target;

    const winners=finish
     ?(
       r.target===1
       ?[
         ...remaining,
         ...eliminated.slice().reverse()
        ].slice(0,3)
       :remaining
      )
     :[];

    tx.update(bref(b.id),{
     status:"exploded"
    });

    tx.update(rref(),{
     alive:remaining,
     eliminated,
     history,
     ...(finish?{
      phase:"finished",
      winners
     }:{})
    });

   });

  }


  /* 確認本回合是否全部爆炸 */

  const latest=await getDoc(rref());

  if(
   latest.exists()&&
   latest.data().phase==="playing"
  ){

   const d=latest.data();

   const ids=Array.from(
    {length:Math.min(5,d.bombTotal||1)},
    (_,i)=>`${d.round}_${i+1}`
   );

   const docs=[];

   for(const id of ids){
    docs.push(await getDoc(bref(id)));
   }

   if(docs.every(s=>
    s.exists()&&
    s.data().status==="exploded"
   )){

    await runTransaction(db,async tx=>{

     const snap=await tx.get(rref());

     if(
      snap.data()?.phase==="playing"&&
      snap.data().round===d.round
     ){
      tx.update(rref(),{
       phase:"between"
      });
     }

    });

   }

  }

 }catch(e){

  console.error(e);
  msg("⚠️ 爆炸結算失敗，請重試");

 }finally{

  settling=false;
  scheduleHost();

 }

}


/* =====================================
   手動結算
===================================== */

$("settle").onclick=settleExpired;


/* =====================================
   重新開始
===================================== */

$("reset").onclick=async()=>{

 if(!host||busy)return;

 if(!confirm("確定重新開始？保留所有玩家。")){
  return;
 }

 busy=true;

 try{

  await runTransaction(db,async tx=>{

   const snap=await tx.get(rref());
   const d=snap.data();

   if(d.hostUid!==uid){
    throw Error("只有主持人可以重設");
   }

   tx.update(rref(),{
    phase:"lobby",
    round:d.round+1,
    alive:[],
    eliminated:[],
    winners:[],
    history:[],
    mode:"classic",
    target:3,
    bombTotal:0
   });

  });

  msg("🔄 已重新開始");

 }catch(e){
  error(e);
 }finally{
  busy=false;
  render();
 }

};


/* =====================================
   分享房間
===================================== */

$("share").onclick=async()=>{

 const url=
  location.origin+
  location.pathname+
  "?room="+encodeURIComponent(room);

 try{

  if(navigator.share){

   await navigator.share({
    title:"上新莊炸彈傳傳樂",
    url
   });

  }else{

   await navigator.clipboard.writeText(url);
   msg("連結已複製");

  }

 }catch(e){

  if(e.name!=="AbortError"){
   prompt("請複製房間連結",url);
  }

 }

};


/* =====================================
   離開畫面
===================================== */

$("leave").onclick=()=>{

 cleanup();

 room="";
 host=false;
 roomData=null;
 players=[];
 bombs=[];

 show("game",false);
 show("entry",true);

 history.replaceState(
  {},
  "",
  location.pathname
 );

};

</script>

